+    pub(super) fn unlink(&self, expected: &Value) -> Result<()> {
+        ensure!(self.current()? == *expected, "Metamodule resource changed before removal");
+        if !expected.is_null() { remove_entry(metamodule_path())?; }
+        sync_dir(Path::new(defs::ADB_DIR))
+    }
+}
